			<munit:enable-flow-source value="get:\addresses\(uprn):bg-premise-ensek-sys-api-config"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when doc:id="81b1950a-d01a-4568-8e54-a6336506632a" doc:name="Mock Addresses Lookup Ensek API Call" processor="http:request">
