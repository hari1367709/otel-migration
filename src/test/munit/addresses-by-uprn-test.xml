				</munit-tools:with-attributes>
				<munit-tools:then-return>
					<munit-tools:payload mediaType="application/json" value="#[output application/json --- readUrl('classpath://addresseses-by-uprn/success-200/ensek-response.json')]"/>
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request config-ref="HTTP_Request_Configuration-GetAddresses" doc:id="f7a0f4cc-87d2-4e93-bc8b-356a44d2dc34" doc:name="Request" method="GET" path="/addresses/100070403101">
				<http:headers><![CDATA[#[{"Accept":"application/json"}]]]></http:headers>
			</http:request>
		</munit:execution>
		<munit:validation>
			<munit-tools:assert-that doc:id="adc5856f-e370-4963-88ab-039542d4a9d7" doc:name="Assert That Status Code is 200" expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(200)]" message="The HTTP Status code is incorrect!"/>
			<munit-tools:assert-that doc:id="99e38ecf-1eb6-4130-bd9a-8031e8ab636e" doc:name="Assert That Payload is Expected" expression="#[output application/json --- payload]" is="#[MunitTools::equalTo(readUrl('classpath://addresseses-by-uprn/success-200/response.json', 'application/json'))]" message="Payload is incorrect!"/>
		</munit:validation>
	</munit:test>
