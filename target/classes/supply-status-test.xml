	<munit:test doc:id="961138e7-4c89-468a-a9ea-7ad90c70bd39" name="get:\(ensekAccountId)\supplyStatus:bg-premise-ensek-sys-api-config-200-application\json-FlowTest">
		<munit:enable-flow-sources>
			<munit:enable-flow-source value="bg-premise-ensek-sys-api-main"/>
			<munit:enable-flow-source value="get:\(ensekAccountId)\supplyStatus:bg-premise-ensek-sys-api-config"/>
		</munit:enable-flow-sources>
		<munit:behavior>
			<munit-tools:mock-when doc:id="bab94a18-985e-4c5c-9de5-ae9f1dbddf6a" doc:name="Mock Ensek Supply Status Get API Call" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="45f5cf1a-b00e-4815-99f9-166b3ddc3cab" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:payload value="#[MunitTools::getResourceAsString('supply-status-get/success-200/response.json')]" mediaType="application/json" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution>
			<http:request config-ref="HTTP_Request_Configuration-supplystatus" doc:id="81169b63-2c57-4b70-aa1a-f0b5f585d8f7" doc:name="Request" method="GET" path="/123175/supplyStatus">
				<http:headers><![CDATA[#[{"Accept":"application/json"}]]]></http:headers>
				<http:response-validator>
					<http:failure-status-code-validator values="404"/>
				</http:response-validator>
			</http:request>
		</munit:execution>
		<munit:validation>
			<logger level="INFO" doc:name="Logger" doc:id="bac527e1-6664-4eba-ac18-2e5747e0b962" message="supplyStatus response 200 : #[%dw 2.0 output application/json --- payload]"/>
			<munit-tools:assert-that doc:id="a2f2c447-4760-4d7a-aaea-117d7dbe80e6" doc:name=" Status Code is 200" expression="#[attributes.statusCode]" is="#[MunitTools::equalTo(200)]" message="The HTTP Status code is incorrect!"/>
			<munit-tools:assert-that doc:id="588b76aa-7322-4db8-a6e7-67d791675713" doc:name="Payload is Expected" expression="#[output application/json --- payload]" is="#[MunitTools::equalTo(readUrl('classpath://supply-status-get/success-200/finalresponse.json', 'application/json'))]" message="Payload is incorrect!"/>
		</munit:validation>
	</munit:test>
